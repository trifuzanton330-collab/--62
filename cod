@bot.message_handler(commands=['start'])
def start(message):
    markup = telebot.types.ReplyKeyboardMarkup(resize_keyboard=True)
    btn = telebot.types.KeyboardButton("📍  Отправить геолокацию", request_location=True)
    markup.add(btn)
    bot.send_message(message.chat.id, "Отправьте геолокацию, чтобы найти ближайшие аптеки:", reply_markup=markup)

@bot.message_handler(content_types=['location'])
def get_location(message):
    user_id = message.from_user.id
    lat, lon = message.location.latitude, message.location.longitude
    user_data[user_id] = {'lat': lat, 'lon': lon}

    # Поиск аптек через Яндекс Карты
    url = "https://search-maps.yandex.ru/v1/"
    params = {
        'apikey': MAPS_API_KEY,
        'text': 'аптека',
        'lang': 'ru_RU',
        'll': f'{lon},{lat}',
        'spn': '0.01,0.01',
        'type': 'biz',
        'results': 3
    }
    try:
        response = requests.get(url, params=params)
        data = response.json()
        pharmacies = data.get('features', [])[:3]

        if pharmacies:
            text = "🏥  Ближайшие аптеки:\n\n"
            for i, p in enumerate(pharmacies, 1):
                name = p['properties']['name']
                addr = p['properties'].get('description', 'Адрес неизвестен')
                text += f"{i}. {name}\n📍  {addr}\n\n"
            bot.send_message(message.chat.id, text)
            bot.send_message(message.chat.id, "Введите название лекарства:")
        else:
            bot.send_message(message.chat.id, "Аптеки не найдены. Попробуйте ещё раз.")
    except Exception as e:
        bot.send_message(message.chat.id, f"Ошибка: {e}")

